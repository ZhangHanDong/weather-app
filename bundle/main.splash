// 行程天气(trip-guardian)S1:天气首页 + 城市面板。
// 数据:Open-Meteo forecast(timezone=auto)+ geocoding;星期由当地日期字符串自算
// (card-host 的 local_time() 是 UTC,不用)。列表渲染只走 on_render,不逐帧跑脚本。

let DEFAULT_CITIES = [
    {name: "深圳" country: "中国" lat: 22.54 lon: 114.06}
    {name: "北京" country: "中国" lat: 39.9 lon: 116.41}
    {name: "上海" country: "中国" lat: 31.23 lon: 121.47}
    {name: "广州" country: "中国" lat: 23.13 lon: 113.26}
    {name: "杭州" country: "中国" lat: 30.27 lon: 120.16}
    {name: "成都" country: "中国" lat: 30.57 lon: 104.07}
    {name: "香港" country: "中国" lat: 22.32 lon: 114.17}
    {name: "台北" country: "中国台湾" lat: 25.03 lon: 121.57}
]

let cities = []
let cur = 0
let wx = nil
let note = "加载中…"
let loading = false
let fetch_seq = 0
let to_timer = nil
let refresh_timer = nil
let panel_open = false
let query = ""
let results = []
let searching = false
let search_note = ""

// ---------- 守护页状态(S2:规则版,无 agent) ----------
let g_screen = "home"            // home | guard
let g_input = ""                 // 一句话原文
let g_place = ""                 // 解析卡:地点标签
let g_date = ""                  // YYYY-MM-DD(按当前城市时区)
let g_start = "09:00"            // HH:MM
let g_dur = 120                  // 分钟
let g_stage = 0                  // 0输入 1解析卡 2风险+方案 3已执行
let g_step = 1                   // #31 分步视图:1 解析 / 2 风险与方案 / 3 结果与行程簿
let h_tab = 0                    // #31 首页两页:0 今天 / 1 10 天(小视口不依赖滚动)
let g_note = "输入一句话计划,开始守护"
let g_risk_level = ""            // 低|中|高|""
let g_risk_line = ""             // 触发因子摘要(每个数字带时间)
let g_risk_src = ""              // 数据时间标注
let g_facts_ok = false           // 计划窗内取到事实
let g_no_forecast = ""           // 超窗提示(非空时不显示风险卡)
let g_opts = []                  // [{id,act,label,why}]
let g_sel = 0
let g_plans = []                 // 行程簿
let g_ledger = []                // 执行台账
let g_last_action_id = ""        // 幂等判重键
let g_verify_line = ""
// S3 agent 通路(#26):探测/回退/校验状态
let g_agent_state = 0            // 0 未探测 1 可用 2 不可用
let g_agent_bad = 0              // 连续不合规次数
let g_agent_pending = false
let g_opt_pending = false          // #33-2: 方案请求进行中(禁用评估按钮)
let g_agent_timer = nil
let g_agent_chan = ""            // parse | options
let g_src_parse = "规则"
let g_agent_reject = false       // #28-5: 拒绝后展示「改用规则」
let g_exec_fail = ""             // #28-4: 执行失败原因(空=成功)
// #30-1: 守护页地点定位
let g_geo = nil                  // {name, label, lat, lon} 定位结果(nil=用当前城市)
let g_geo_note = ""              // 「按〈深圳湾 · 广东省深圳市〉的预报」或「没找到…按当前城市〈北京〉的预报」
let g_src_opts = "规则"

// ---------- 工具 ----------

// 缺字段访问是错误而不是 nil(Gotchas):先数键再取值。
fn has_key(o, k){
    for kk vv in o {
        if kk == k { return true }
    }
    return false
}

fn int_str(v){
    if v == nil { return "—" }
    let r = round(v)
    let s = "" + r
    if s.search(".") >= 0 { s = s.split(".")[0] }
    return s
}

fn deg(v){
    if v == nil { return "—" }
    return int_str(v) + "°"
}

fn wd_name(wi){
    if wi == 0 { return "周日" }
    if wi == 1 { return "周一" }
    if wi == 2 { return "周二" }
    if wi == 3 { return "周三" }
    if wi == 4 { return "周四" }
    if wi == 5 { return "周五" }
    return "周六"
}

// "2026-09-29" → "9/29 周二"(星期自算,不依赖本地时区)
fn short_date(ds){
    let p = ds.split("-")
    if p.len() < 3 { return ds }
    let y = p[0].to_f64()
    let m = p[1].to_f64()
    let d = p[2].to_f64()
    if !(y >= 0 && m >= 1 && d >= 1) { return ds }
    let yy = y
    let mm = m
    if mm <= 2 {
        yy = y - 1
        mm = m + 12
    }
    let era = floor(yy / 400.0)
    let yoe = yy - era * 400.0
    let doy = floor((153.0 * (mm - 3.0) + 2.0) / 5.0) + d - 1.0
    let doe = yoe * 365.0 + floor(yoe / 4.0) - floor(yoe / 100.0) + doy
    let days = era * 146097.0 + doe - 719468.0
    let wd = days - floor(days / 7.0) * 7.0
    let wi = wd + 4.0
    wi = wi - floor(wi / 7.0) * 7.0
    return "" + m + "/" + d + " " + wd_name(wi)
}

// "2026-09-28T13:15" → "9/28 13:15"
fn fmt_dt(iso){
    if iso == nil { return "" }
    let pt = iso.split("T")
    if pt.len() < 2 { return iso }
    let d = pt[0].split("-")
    if d.len() < 3 { return iso }
    let m = d[1].to_f64()
    let day = d[2].to_f64()
    if !(m >= 1 && day >= 1) { return iso }
    return "" + m + "/" + day + " " + pt[1]
}

fn wmo_zh(code){
    if code == nil { return "—" }
    if code == 0 { return "晴" }
    if code == 1 { return "基本晴" }
    if code == 2 { return "局部多云" }
    if code == 3 { return "阴" }
    if code == 45 || code == 48 { return "雾" }
    if code >= 51 && code <= 57 { return "毛毛雨" }
    if code >= 61 && code <= 67 { return "雨" }
    if code >= 71 && code <= 77 { return "雪" }
    if code >= 80 && code <= 82 { return "阵雨" }
    if code == 85 || code == 86 { return "阵雪" }
    if code >= 95 { return "雷雨" }
    return "—"
}

// ---------- 存储 ----------

fn save_cities(){ fs.write("cities.json", {list: cities sel: cur}.to_json()) }

fn load_cities(){
    cities = []
    for c in DEFAULT_CITIES { cities.push(c) }
    cur = 0
    if file_ok("cities.json") {
        let v = fs.read("cities.json").parse_json()
        if v != nil && v.list != nil && v.list.len() > 0 {
            let got = []
            for c in v.list {
                if c.name != nil && c.lat != nil && c.lon != nil {
                    let co = c.country
                    if co == nil { co = "" }
                    got.push({name: c.name country: co lat: c.lat lon: c.lon})
                }
            }
            if got.len() > 0 { cities = got }
            if v.sel != nil { cur = v.sel }
        }
    }
    if cur >= cities.len() { cur = 0 }
}

// ---------- 取数 ----------

fn fetch(url){
    let p = promise()
    net.http_request(net.HttpRequest{url: url method: net.HttpMethod.GET headers: {"User-Agent": "TripGuardian/0.1"}}) do net.HttpEvents{
        on_response: |res| p.resolve(res)
        on_error: |_err| p.resolve(nil)
    }
    p
}

fn forecast_url(c){
    return "https://api.open-meteo.com/v1/forecast?latitude=" + c.lat + "&longitude=" + c.lon
        + "&current=temperature_2m,weather_code"
        + "&hourly=temperature_2m,precipitation_probability,precipitation,apparent_temperature,wind_speed_10m,uv_index"
        + "&daily=temperature_2m_max,temperature_2m_min,weather_code,precipitation_probability_max"
        + "&timezone=auto&forecast_days=16"
}

// "2026-09-28T13:15" → "2026-09-28T13:"(逐小时数组里找当前小时的锚)
fn hour_prefix(iso){
    let pt = iso.split("T")
    if pt.len() < 2 { return "" }
    let hm = pt[1].split(":")
    if hm.len() < 1 { return "" }
    return pt[0] + "T" + hm[0] + ":"
}

fn parse_forecast(body){
    let data = body.parse_json()
    if data == nil { return nil }
    if !has_key(data, "current") { return nil }
    let ctm = data.current.time
    if ctm == nil { return nil }
    let hall = []
    if has_key(data, "hourly") && has_key(data.hourly, "time") {
        let ht = data.hourly.time
        for j in ht.len() {
            let pt = ht[j].split("T")
            let hh = ""
            if pt.len() >= 2 { hh = pt[1].split(":")[0] }
            let pr = nil
            if has_key(data.hourly, "precipitation") { pr = data.hourly.precipitation[j] }
            let ap = nil
            if has_key(data.hourly, "apparent_temperature") { ap = data.hourly.apparent_temperature[j] }
            let ws = nil
            if has_key(data.hourly, "wind_speed_10m") { ws = data.hourly.wind_speed_10m[j] }
            let uv = nil
            if has_key(data.hourly, "uv_index") { uv = data.hourly.uv_index[j] }
            hall.push({ds: pt[0] h: hh t: data.hourly.temperature_2m[j] p: data.hourly.precipitation_probability[j] pr: pr ap: ap ws: ws uv: uv})
        }
    }
    let hours = []
    let prefix = hour_prefix(ctm)
    let start = -1
    if prefix != "" {
        for i in hall.len() {
            if hall[i].ds + "T" + hall[i].h + ":" == prefix { start = i break }
        }
    }
    if start < 0 && hall.len() > 0 { start = 0 }
    if start >= 0 {
        for k in 24 {
            let j = start + k
            if j >= hall.len() { break }
            hours.push({h: hall[j].h t: hall[j].t p: hall[j].p})
        }
    }
    let days = []
    if has_key(data, "daily") && has_key(data.daily, "time") {
        let dt = data.daily.time
        for j in dt.len() {
            if j >= 10 { break }
            days.push({ds: dt[j] hi: data.daily.temperature_2m_max[j] lo: data.daily.temperature_2m_min[j] code: data.daily.weather_code[j] pp: data.daily.precipitation_probability_max[j]})
        }
    }
    let hi = nil
    let lo = nil
    if days.len() > 0 { hi = days[0].hi lo = days[0].lo }
    return {temp: data.current.temperature_2m code: data.current.weather_code time: ctm hi: hi lo: lo hours: hours hall: hall days: days}
}

// 15 秒超时:到点仍无响应 → 作废这轮,保留上次成功数据并提示
fn on_fetch_timeout(seq){
    if seq != fetch_seq { return }
    fetch_seq = fetch_seq + 1
    loading = false
    if wx == nil {
        note = "加载超时(15 秒),还没有可用数据"
    } else {
        note = "加载超时(15 秒),显示上次成功数据 · " + fmt_dt(wx.time)
    }
    render_home()
}

fn refresh(){
    if loading { return }
    if cities.len() == 0 { return }
    loading = true
    fetch_seq = fetch_seq + 1
    let seq = fetch_seq
    note = "加载中…"
    render_home()
    to_timer = start_timeout(15.0, || on_fetch_timeout(seq))
    let res = fetch(forecast_url(cities[cur])).await()
    stop_timer(to_timer)
    if seq != fetch_seq { return }
    loading = false
    if res == nil || res.status_code >= 400 {
        if wx == nil { note = "取数失败,稍后自动重试" }
        else { note = "取数失败,显示上次成功数据 · " + fmt_dt(wx.time) }
        render_home()
        return
    }
    let parsed = parse_forecast(res.body.to_string())
    if parsed == nil {
        if wx == nil { note = "数据解析失败,稍后自动重试" }
        else { note = "数据解析失败,显示上次成功数据 · " + fmt_dt(wx.time) }
        render_home()
        return
    }
    wx = parsed
    note = "已更新 · " + fmt_dt(wx.time)
    render_home()
}

// ---------- 渲染 ----------

fn htab(n){
    h_tab = n
    ui.h_today.set_visible(n == 0)
    ui.h_days.set_visible(n == 1)
}

fn render_home(){
    if cities.len() == 0 {
        ui.temp_lbl.set_text("—")
        ui.cond_lbl.set_text("还没有城市")
        ui.hilo_lbl.set_text("点右上「切换」搜索并添加一个城市")
        ui.hours_hdr.set_text("未来 24 小时 · 数据来自 Open-Meteo")
        ui.days_hdr.set_text("10 天预报 · 数据来自 Open-Meteo")
        ui.hours_strip.render()
        ui.days_list.render()
        ui.note_lbl.set_text("")
        return
    }
    if wx == nil {
        ui.temp_lbl.set_text("—")
        ui.cond_lbl.set_text("暂无数据")
        ui.hilo_lbl.set_text("")
    } else {
        ui.temp_lbl.set_text(deg(wx.temp))
        ui.cond_lbl.set_text(wmo_zh(wx.code))
        ui.hilo_lbl.set_text("最高 " + deg(wx.hi) + " · 最低 " + deg(wx.lo))
    }
    ui.note_lbl.set_text(note)
    if wx == nil {
        ui.hours_hdr.set_text("未来 24 小时 · 数据来自 Open-Meteo")
        ui.days_hdr.set_text("10 天预报 · 数据来自 Open-Meteo")
    } else {
        let stamp = " · 数据时间 " + fmt_dt(wx.time)
        ui.hours_hdr.set_text("未来 24 小时 · 数据来自 Open-Meteo" + stamp)
        ui.days_hdr.set_text("10 天预报 · 数据来自 Open-Meteo" + stamp)
    }
    ui.h_today.set_visible(h_tab == 0)
    ui.h_days.set_visible(h_tab == 1)
    ui.hours_strip.render()
    ui.days_list.render()
}

// ---------- 城市面板 ----------

fn render_panel(){
    ui.search_note.set_text(search_note)
    ui.result_rows.render()
    ui.city_rows.render()
}

fn open_panel(){
    panel_open = true
    ui.panel.set_visible(true)
    render_panel()
}

fn close_panel(){
    panel_open = false
    ui.panel.set_visible(false)
}

fn toggle_panel(){
    if panel_open { close_panel() } else { open_panel() }
}

fn coord_str(la, lo){
    return "(" + round(la*100.0)/100.0 + ", " + round(lo*100.0)/100.0 + ")"
}

// 候选行说明:admin2(区县)优先,缺失时用经纬度补;
// 同名同区仍分不开的,由 do_search 再补坐标(见下)。
fn geo_label(r){
    let s = ""
    let has2 = has_key(r, "admin2") && r.admin2 != nil && r.admin2 != ""
    if has2 {
        s = r.admin2
        if has_key(r, "admin1") && r.admin1 != nil && r.admin1 != "" && r.admin1 != r.admin2 { s = s + " · " + r.admin1 }
    } else if has_key(r, "admin1") && r.admin1 != nil && r.admin1 != "" {
        s = r.admin1
    }
    if has_key(r, "country") && r.country != nil && r.country != "" { s = s + " · " + r.country }
    if !has2 { s = s + " " + coord_str(r.latitude, r.longitude) }
    return s
}

fn plain_country(r){
    let s = ""
    if has_key(r, "admin1") && r.admin1 != nil && r.admin1 != "" { s = r.admin1 }
    if has_key(r, "country") && r.country != nil && r.country != "" {
        if s == "" { s = r.country } else { s = s + " · " + r.country }
    }
    if s == "" { s = "—" }
    return s
}

fn do_search(text){
    query = text.trim()
    if query == "" { return }
    results = []
    searching = true
    search_note = "搜索中…"
    render_panel()
    let url = "https://geocoding-api.open-meteo.com/v1/search?name=" + query.url_encode() + "&count=10&language=zh&format=json"
    let res = fetch(url).await()
    searching = false
    if res == nil || res.status_code >= 400 {
        search_note = "搜索失败,请稍后再试"
        render_panel()
        return
    }
    let data = res.body.to_string().parse_json()
    let got = []
    if data != nil && has_key(data, "results") {
        for r in data.results {
            if r.name == nil || r.latitude == nil || r.longitude == nil { continue }
            got.push({name: r.name country: geo_label(r) plain: plain_country(r) lat: r.latitude lon: r.longitude})
        }
    }
    // 同名候选若说明仍相同(如两个「重庆市 · 中国」),给后出现的补经纬度
    for i in got.len() {
        for j in i {
            if got[j].country == got[i].country {
                got[i].country = got[i].country + " " + coord_str(got[i].lat, got[i].lon)
                break
            }
        }
    }
    results = got
    if results.len() == 0 {
        search_note = "找不到「" + query + "」,换个说法试试"
    } else {
        search_note = "" + results.len() + " 个候选,点击选择"
    }
    render_panel()
}

fn pick_hit(h){
    let dup = -1
    for i in cities.len() {
        if cities[i].name == h.name && abs(cities[i].lat - h.lat) < 0.01 && abs(cities[i].lon - h.lon) < 0.01 { dup = i }
    }
    if dup >= 0 { select_city(dup) return }
    let pc = h.plain
    if pc == nil || pc == "" { pc = h.country }
    cities.push({name: h.name country: pc lat: h.lat lon: h.lon})
    select_city(cities.len() - 1)
}

fn select_city(i){
    if i >= cities.len() { return }
    cur = i
    save_cities()
    ui.city_btn.set_text(cities[cur].name + " 切换")
    close_panel()
    refresh()
}

// ---------- 守护页:日期/星期计算 ----------

// 今日(当地)= 当前天气数据时间的日期(timezone=auto,已是当地)
fn today_str(){
    if wx == nil { return "" }
    return wx.time.split("T")[0]
}

fn days_of(ds){
    let p = ds.split("-")
    let y = p[0].to_f64()
    let m = p[1].to_f64()
    let d = p[2].to_f64()
    let yy = y
    let mm = m
    if mm <= 2 { yy = y - 1 mm = m + 12 }
    let era = floor(yy / 400.0)
    let yoe = yy - era * 400.0
    let doy = floor((153.0 * (mm - 3.0) + 2.0) / 5.0) + d - 1.0
    let doe = yoe * 365.0 + floor(yoe / 4.0) - floor(yoe / 100.0) + doy
    return era * 146097.0 + doe - 719468.0
}

fn wd_of(ds){
    let days = days_of(ds)
    let wd = days - floor(days / 7.0) * 7.0
    let wi = wd + 4.0
    wi = wi - floor(wi / 7.0) * 7.0
    return wi
}

fn next_date(ds){
    let days = days_of(ds) + 1.0
    let z = days + 719468.0
    let era = floor(z / 146097.0)
    let doe = z - era * 146097.0
    let yoe = floor((doe - floor(doe/1460.0) + floor(doe/36524.0) - floor(doe/146096.0)) / 365.0)
    let y = yoe + era * 400.0
    let doy = doe - (365.0*yoe + floor(yoe/4.0) - floor(yoe/100.0))
    let mp = floor((5.0*doy + 2.0) / 153.0)
    let d = doy - floor((153.0*mp + 2.0)/5.0) + 1.0
    let m = mp + 3.0
    if mp >= 10 { m = mp - 9.0 }
    if m <= 2 { return fmt_ds(y + 1.0, m, d) }
    return fmt_ds(y, m, d)
}

fn fmt_ds(y, m, d){
    let ms = "" + round(m)
    let ds = "" + round(d)
    let ys = "" + round(y)
    if m < 10.0 { ms = "0" + ms }
    if d < 10.0 { ds = "0" + ds }
    return ys + "-" + ms + "-" + ds
}

// ---------- 守护页:本地规则解析 ----------
// 日期:今天/明天/后天/周X/M月D日/M/D;时间:上午/下午/晚上 N点[半]/HH:MM;
// 时长:N小时/半天(默认120);地点:「去…」到下一个动词前的片段。
fn g_parse(){
    let text = g_input.trim()
    if text == "" { g_note = "先输入一句话,例如:周六上午 9 点去深圳湾骑车" return }
    let today = today_str()
    if today == "" { g_note = "天气数据还没就绪,稍等再试" return }
    let pdate = ""
    // 相对日(今晚/今早/明早/明晚 也锚定日期)
    if text.search("后天") >= 0 { pdate = shift_date(today, 2) }
    elif text.search("明早") >= 0 || text.search("明晚") >= 0 || text.search("明天") >= 0 { pdate = shift_date(today, 1) }
    elif text.search("今晚") >= 0 || text.search("今早") >= 0 || text.search("今天") >= 0 { pdate = today }
    // 周X
    if pdate == "" {
        let names = ["周日","周一","周二","周三","周四","周五","周六"]
        let alt = ["星期日","星期一","星期二","星期三","星期四","星期五","星期六"]
        let want = -1
        for i in 7 {
            if text.search(names[i]) >= 0 { want = i break }
        }
        if want < 0 {
            for i in 7 {
                if text.search(alt[i]) >= 0 { want = i break }
            }
        }
        if want >= 0 {
            let cur_wd = wd_of(today)
            let d = want - cur_wd
            if d <= 0 { d = d + 7 }
            if text.search("下周") >= 0 || text.search("下星期") >= 0 { d = d + 7 }
            pdate = shift_date(today, d)
        }
    }
    // M月D日 / M/D(按今年;9/29 → 2026-09-29)
    if pdate == "" {
        let m = match_num_cn(text, "月")
        if m >= 1 {
            let d = match_day_after(text)
            if d >= 1 { pdate = fmt_ds(year_of(today), m, d + 0.0) }
        }
    }
    if pdate == "" {
        let md = match_slash(text)
        if md != nil { pdate = fmt_ds(year_of(today), md[0], md[1]) }
    }
    if pdate == "" { pdate = today }
    // 时间
    let hh = -1
    let mm = 0
    let t_found = false
    let t24 = parse_hhmm(text)
    if t24 != nil { hh = t24[0] mm = t24[1] t_found = true }
    else {
        let h12 = parse_cn_hour(text)
        if h12 != nil { hh = h12[0] mm = h12[1] t_found = true }
    }
    if t_found && hh > 23 { hh = -1 t_found = false }
    // 时长
    let dur = 120
    let du = parse_dur(text)
    if du > 0 { dur = du }
    // 日期默认今天(如实告知,不算缺项)
    let date_is_today = pdate == today
    let mp = split_multi_place(parse_place(text))
    g_place = mp.first
    let place_extra = mp.extra
    g_date = pdate
    g_start = ""
    if t_found { g_start = fmt_hm(hh + 0.0, mm + 0.0) }
    g_dur = dur
    g_stage = 1
    g_no_forecast = ""
    g_verify_line = ""
    // 缺项提示(#24/#25-3):缺项框留空;日期默认今天要写明。
    let missing = []
    if g_place == "" { missing.push("地点") }
    if !t_found { missing.push("时间") }
    if missing.len() > 0 {
        g_note = "已解析,但缺:" + join_list(missing) + " · 请在解析卡补全后再评估"
    } else {
        g_note = "已解析(本地规则)· 按「评估风险」继续"
    }
    if missing.len() > 0 && date_is_today {
        g_note = "已解析,但缺:" + join_list(missing) + " · 日期按今天;请在解析卡补全后再评估"
    }
    if missing.len() == 0 && date_is_today && text.search("今天") < 0 && text.search("明天") < 0 && text.search("后天") < 0 {
        g_note = "已解析(日期按今天)· 按「评估风险」继续"
    }
    if place_extra != "" { g_note = g_note + " · 还提到:" + place_extra + "(可在解析卡修改)" }
    render_guard()
}

fn year_of(ds){ return ds.split("-")[0].to_f64() }

fn shift_date(ds, n){
    let out = ds
    for i in n { out = next_date(out) }
    return out
}

fn fmt_hm(h, m){
    let hs = "" + round(h)
    let ms = "" + round(m)
    if h < 10.0 { hs = "0" + hs }
    if m < 10.0 { ms = "0" + ms }
    return hs + ":" + ms
}

// "9 点/9:30/09:00" → {h,m};上下午前缀换算
fn parse_hhmm(text){
    let t = text
    let pm = t.search("下午") >= 0 || t.search("晚上") >= 0 || t.search("傍晚") >= 0 || t.search("今晚") >= 0 || t.search("明晚") >= 0
    let rg = regex("([0-9]{1,2})[:点时]([0-9]{2})", "")
    let m = rg.exec(t)
    if m != nil && m.captures.len() >= 3 {
        let h = m.captures[1].to_f64()
        let mi = m.captures[2].to_f64()
        if pm && h < 12.0 { h = h + 12.0 }
        if h >= 24.0 { return nil }
        return [h, mi]
    }
    let rg2 = regex("([0-9]{1,2}) *[:点时]", "")
    let m2 = rg2.exec(t)
    if m2 != nil && m2.captures.len() >= 2 {
        let h = m2.captures[1].to_f64()
        if pm && h < 12.0 { h = h + 12.0 }
        if h >= 24.0 { return nil }
        // 「3点半」:命中点位的紧后是「半」→ :30
        let idx_half = t.search("半")
        if idx_half >= 0 && idx_half - m2.index >= 0 && idx_half - m2.index <= 10 { return [h, 30.0] }
        return [h, 0.0]
    }
    return nil
}

// 「九点」「上午九点」中文数字 1-12 + 可选「半」
fn parse_cn_hour(text){
    let t = text
    let pm = t.search("下午") >= 0 || t.search("晚上") >= 0 || t.search("傍晚") >= 0 || t.search("今晚") >= 0 || t.search("明晚") >= 0
    // 「今晚/明晚」里的「晚」不是 pm 信号本身,先剥掉再找点数
    let t2 = t
    if t.search("今晚") >= 0 { t2 = t.replace("今晚", "X") }
    let pm2 = t2.search("下午") >= 0 || t2.search("晚上") >= 0 || t2.search("傍晚") >= 0
    let cands = [["一",1.0],["二",2.0],["两",2.0],["三",3.0],["四",4.0],["五",5.0],["六",6.0],["七",7.0],["八",8.0],["九",9.0],["十",2.0]]
    for c in cands {
        let idx = t.search(c[0] + "点")
        if idx >= 0 {
            let h = c[1]
            if c[0] == "十" { h = 10.0 }
            if (pm || pm2) && h < 12.0 { h = h + 12.0 }
            if h >= 24.0 { return nil }
            if t.search("半") >= 0 && t.search("半") - idx <= 10 { return [h, 30.0] }
            return [h, 0.0]
        }
    }
    return nil
}

// 中文数字月:M月;日:D日/D 号
fn match_num_cn(text, suffix){
    let cands = [["一",1.0],["二",2.0],["三",3.0],["四",4.0],["五",5.0],["六",6.0],["七",7.0],["八",8.0],["九",9.0],["十",10.0],["十一",11.0],["十二",12.0]]
    let i = text.search(suffix)
    if i < 0 { return -1 }
    let head = text.split(suffix)[0]
    for c in cands {
        if head.search(c[0] + suffix) >= 0 { return c[1] }
    }
    // 阿拉伯数字
    let m = regex("([0-9]{1,2})月", "").exec(text)
    if m != nil && m.captures.len() >= 2 { return m.captures[1].to_f64() }
    return -1
}

fn match_day_after(text){
    let m = regex("([0-9]{1,2}) *[日号]", "").exec(text)
    if m != nil && m.captures.len() >= 2 { return m.captures[1].to_f64() }
    let cands = [["一",1.0],["二",2.0],["三",3.0],["四",4.0],["五",5.0],["六",6.0],["七",7.0],["八",8.0],["九",9.0],["三十",30.0],["二十",20.0],["十",10.0]]
    for c in cands {
        if text.search(c[0] + "日") >= 0 || text.search(c[0] + "号") >= 0 { return c[1] }
    }
    return -1
}

fn match_slash(text){
    let m = regex("([0-9]{1,2})/([0-9]{1,2})", "").exec(text)
    if m != nil && m.captures.len() >= 3 {
        let mo = m.captures[1].to_f64()
        let d = m.captures[2].to_f64()
        if mo >= 1.0 && mo <= 12.0 && d >= 1.0 && d <= 31.0 { return [mo, d] }
    }
    return nil
}

fn parse_dur(text){
    let m = regex("([0-9]{1,2}) *个?小时", "").exec(text)
    if m != nil && m.captures.len() >= 2 {
        let h = m.captures[1].to_f64()
        if h >= 1.0 && h <= 12.0 { return round(h * 60.0) }
    }
    // 「一个半小时」90 /「一个小时」「一个钟」60 /「一个半钟头」90
    if text.search("一个半") >= 0 { return 90 }
    if text.search("一个小时") >= 0 || text.search("一个钟") >= 0 { return 60 }
    if text.search("两小时") >= 0 || text.search("两个小时") >= 0 { return 120 }
    if text.search("半天") >= 0 { return 240 }
    if text.search("半小时") >= 0 { return 30 }
    let mc = regex("([0-9]{1,2}) *分钟", "").exec(text)
    if mc != nil && mc.captures.len() >= 2 {
        let v = mc.captures[1].to_f64()
        if v >= 15.0 { return round(v) }
    }
    return 0
}

// 地点:「去<place>」到 骑车/爬山/跑步/露营/野餐/散步/拍照/看日出/看日落 或句尾
// #34-3: 一句话两个地点(「深圳湾和蛇口」)→ 取第一个,另一个写进提示。
fn split_multi_place(p){
    for sep in ["和","跟","与"] {
        let i = p.search(sep)
        if i > 2 {   // 「A和B」:A 至少 2 字
            let parts = p.split(sep)
            if parts.len() >= 2 {
                let first = parts[0].trim()
                let rest = parts[1].trim()
                for st in ["看日出","看日落","看海","逛街","游泳","骑车","骑行","爬山","跑步","徒步","露营","野餐","散步","拍照","玩水","钓鱼","放风筝"] {
                    let suf = rest.strip_suffix(st)
                    if suf != nil && suf != rest { rest = suf break }
                }
                if first != "" && rest != "" { return {first: first extra: rest} }
            }
        }
    }
    return {first: p extra: ""}
}

fn parse_place(text){
    let i = text.search("去")
    if i < 0 { return "" }
    // 「去」之后到第一个活动词/句尾
    let stops = ["看日出","看日落","看海","逛街","游泳","骑车","骑行","爬山","跑步","徒步","露营","野餐","散步","拍照","玩水","钓鱼","放风筝"]
    // 兜底:地点 2-4 字,遇常见动词字截断(放/看/吃/玩/逛/跑/骑/爬/拍/钓)
    let verbs = ["放","看","吃","玩","逛","跑","骑","爬","拍","钓"]
    let tail = text
    for st in stops {
        let m = regex("去([一-龥A-Za-z0-9]+)" + st, "").exec(text)
        if m != nil && m.captures.len() >= 2 { tail = m.captures[1] break }
    }
    if tail == text {
        let m2 = regex("去([一-龥A-Za-z0-9]+)", "").exec(text)
        if m2 != nil && m2.captures.len() >= 2 { tail = m2.captures[1] }
    }
    // 尾部剥离残留活动词(「大梅沙游泳」→「大梅沙」;多轮防「玩」类单字循环)
    let again = true
    let guard_n = 0
    while again && guard_n < 6 {
        again = false
        guard_n = guard_n + 1
        for st in stops {
            let suf = tail.strip_suffix(st)
            if suf != nil && suf != tail {
                tail = suf
                again = true
                break
            }
        }
    }
    // 动词字兜底(#26-5):从 tail 第一个常见动词字起截断(「莲花山放风筝」→「莲花山」)
    let cut = -1
    let win_v = ""
    for v in verbs {
        let vi = tail.search(v)
        if vi >= 0 && (cut < 0 || vi < cut) { cut = vi win_v = v }
    }
    if cut > 1 {
        tail = tail.split(win_v)[0]
    }
    return tail.trim()
}

// ---------- 守护页:地点定位(#30-1) ----------
// 解析出地点后先用 geocoding 定位;搜到 → 用其经纬度取该窗预报;搜不到 → 退回当前城市并写明。
fn geo_try(q){
    let url = "https://geocoding-api.open-meteo.com/v1/search?name=" + q.url_encode() + "&count=1&language=zh&format=json"
    let res = fetch(url).await()
    if res == nil || res.status_code >= 400 { return nil }
    let data = res.body.to_string().parse_json()
    if data == nil || !has_key(data, "results") { return nil }
    let rs = data.results
    if rs.len() == 0 { return nil }
    let r = rs[0]
    if r.name == nil || r.latitude == nil || r.longitude == nil { return nil }
    return {name: r.name label: plain_country(r) lat: r.latitude lon: r.longitude}
}

// 「深圳湾」不是地理编码条目(实测 0 结果)——用 strip_suffix 链渐进截尾
// (字符串无切片 API;每轮剥一个常见通名后缀,最少留 2 字/6 字节)。
fn geo_one(q){
    let got = geo_try(q)
    if got != nil { return got }
    let cur = q
    let n = 0
    while cur.len() > 4 && n < 6 {     // 每个 CJK 字 3 字节;2 字 = 6 字节
        cur = cur.split("")[0]
        // split("") 行为不可靠——改用 slice 语义:重建去掉末字节×3
        n = n + 1
    }
    // 上面 while 不可靠,直接做确定次数截尾
    let parts = q.split("")
    if parts.len() > 3 {
        // 中文按 3 字节;取前 len-3 字节
        got = geo_try(q.split(parts[parts.len()-1])[0])
        if got != nil { return got }
    }
    if q.len() > 6 {
        got = geo_try(q.strip_suffix("湾"))
        if got != nil { return got }
        got = geo_try(q.strip_suffix("公园"))
        if got != nil { return got }
    }
    return nil
}

// g_assess 的取数前置:定位 → (必要时)取该点预报 → 缓存到 g_wx_place/g_wx_guard
let g_wx_guard = nil   // 守护页专用预报(地点定位后)
let g_wx_guard_key = ""  // "lat,lon" 缓存键

fn guard_fetch_for(place){
    let p = geo_one(place)
    if p == nil {
        g_geo = nil
        g_geo_note = "没找到「" + place + "」,按当前城市〈" + cities[cur].name + "〉的预报"
        g_wx_guard = nil
        g_wx_guard_key = ""
        return
    }
    let key = "" + p.lat + "," + p.lon
    g_geo = p
    g_geo_note = "按〈" + p.name + " · " + p.label + "〉的预报"
    if key != g_wx_guard_key {
        g_wx_guard_key = key
        let url = "https://api.open-meteo.com/v1/forecast?latitude=" + p.lat + "&longitude=" + p.lon
            + "&current=temperature_2m,weather_code"
            + "&hourly=temperature_2m,precipitation_probability,precipitation,apparent_temperature,wind_speed_10m,uv_index"
            + "&daily=temperature_2m_max,temperature_2m_min,weather_code,precipitation_probability_max"
            + "&timezone=auto&forecast_days=16"
        let res = fetch(url).await()
        if res == nil || res.status_code >= 400 {
            g_wx_guard = nil
            g_wx_guard_key = ""
            g_geo_note = "按〈" + p.name + " · " + p.label + "〉取数失败,稍后再试"
            return
        }
        g_wx_guard = parse_forecast(res.body.to_string())
        if g_wx_guard == nil {
            g_wx_guard_key = ""
            g_geo_note = "按〈" + p.name + " · " + p.label + "〉数据解析失败,稍后再试"
        }
    }
}

// 守护页取当前生效的预报(wx 代理)
fn guard_wx(){
    if g_geo != nil && g_wx_guard != nil { return g_wx_guard }
    return wx
}

// ---------- 守护页:事实与风险 ----------
// 阈值出处:Rust 版 src/guardian_g2.rs:178-188 THRESHOLDS
//   降水概率 ≥60 高 / 30-59 中;小时降水量 ≥2 高 / 0.5-1.9 中;
//   体感 ≥35 或 ≤0 高 / 32-34.9 中;风速(户外) ≥38 高 / 28-37 中;UV ≥8 中。
fn g_assess(){
    if wx == nil { g_note = "天气数据还没就绪,稍等再试" render_guard() return }
    if g_place == "" || g_start == "" {
        g_note = "解析卡还有缺项(地点/时间),补全后再评估"
        render_guard()
        return
    }
    // #30-1: 先定位地点(搜到 → 专用预报;搜不到 → 退回当前城市并写明)
    guard_fetch_for(g_place)
    let w = guard_wx()
    if w == nil { g_note = g_geo_note render_guard() return }
    let hall = w.hall
    if hall.len() == 0 { g_note = "逐小时数据不可用,稍后再试" render_guard() return }
    // 窗口小时(start 的 HH,含 start 整点,共 ceil(dur/60)+1 个采样)
    let sh = g_start.split(":")[0].to_f64()
    let span = ceil(g_dur / 60.0)
    let rows = []
    for k in span + 1 {
        let h = sh + k
        if h > 23 { break }
        for r in hall {
            if r.ds == g_date && r.h.to_f64() == h { rows.push(r) break }
        }
    }
    if rows.len() == 0 {
        // 该日期无逐小时数据 → 超窗(预报只到今天+15 天)
        g_no_forecast = gap_days_str(g_date) + "后的天气还没有可靠预报"
        g_risk_level = ""
        g_risk_line = ""
        g_opts = []
        g_stage = 1
        g_note = "超出预报范围,可改日期后重新评估"
        render_guard()
        return
    }
    g_no_forecast = ""
    // 逐因子取窗内最差值(时间点带在括号里)
    let pp_w = worst_row(rows, "p")
    let pr_w = worst_row(rows, "pr")
    let ap_w = worst_row(rows, "ap")
    let ws_w = worst_row(rows, "ws")
    let uv_w = worst_row(rows, "uv")
    let hits = []
    let level = "低"
    if pp_w != nil && pp_w.v >= 60.0 { level = "高" hits.push("降水概率") }
    elif pp_w != nil && pp_w.v >= 30.0 { level = "中" hits.push("降水概率") }
    if pr_w != nil && pr_w.v >= 2.0 { level = "高" hits.push("小时降水量") }
    elif pr_w != nil && pr_w.v >= 0.5 { level = "中" hits.push("小时降水量") }
    if ap_w != nil && (ap_w.v >= 35.0 || ap_w.v <= 0.0) { level = "高" hits.push("体感温度") }
    elif ap_w != nil && ap_w.v >= 32.0 { level = "中" hits.push("体感温度") }
    if ws_w != nil && ws_w.v >= 38.0 { level = "高" hits.push("风速") }
    elif ws_w != nil && ws_w.v >= 28.0 { level = "中" hits.push("风速") }
    if uv_w != nil && uv_w.v >= 8.0 { if level == "低" { level = "中" } hits.push("UV指数") }
    g_step = 2
    g_risk_level = level
    g_risk_line = hit_line(rows, hits)
    g_risk_src = "Open-Meteo · 数据时间 " + fmt_dt(wx.time)
    g_facts_ok = true
    g_stage = 2
    if g_agent_state == 2 {
        g_src_opts = "规则"
        build_options(level, hits, pp_w, pr_w, ap_w, uv_w)
        g_note = "风险:" + level + " · " + g_geo_note + " · " + agent_unavailable_note()
        render_guard()
        return
    }
    g_note = "风险:" + level + " · 正在请 agent 出方案…"
    g_opt_pending = true
    render_guard()
    // #29-5b: 把代码选定的改期目标一并告诉 agent,why 围绕它写
    let resched_hint = ""
    let next_t = ""
    for i in 5 {
        let cand = shift_date(g_date, i + 1)
        if day_level(cand) != "高" { next_t = cand break }
    }
    if next_t != "" { resched_hint = "。若建议改期,目标日期是 " + next_t + "(" + short_date(next_t) + " 同一时段)" }
    let prompt = "计划窗口风险等级:" + level + "。事实(窗内最差值,数据时间 " + fmt_dt(wx.time) + "):" + g_risk_line + resched_hint + "。请只回 JSON:{options:[{action,why,checklist[]}]},1-3 项;action 只能是 reschedule/mark_indoor/add_checklist/keep 之一;checklist 只能来自 [雨具,补水,保暖衣物,防晒];why 里的每个数字必须来自上面事实;不得含 URL。"
    agent_ask("options", prompt)
}

// rows 里某字段的最差(最大)值
fn worst_row(rows, key){
    // hall rows are script literals: has_key (key iteration) does not see
    // their keys (PROBE1-3, board #24); dispatch on key name instead.
    let best = nil
    for r in rows {
        let v = nil
        if key == "p" { if r.p != nil { v = r.p } }
        if key == "pr" { if r.pr != nil { v = r.pr } }
        if key == "ap" { if r.ap != nil { v = r.ap } }
        if key == "ws" { if r.ws != nil { v = r.ws } }
        if key == "uv" { if r.uv != nil { v = r.uv } }
        if v != nil {
            if best == nil || v > best.v { best = {k: key v: v h: r.h} }
        }
    }
    return best
}

// #25-5:风险卡五项全列(窗内最差值+小时),不只列触发因子;触发项加「▲」。
fn hit_line(rows, hits){
    let items = [
        {name: "降水概率" key: "p" fmt: "%"},
        {name: "降水量" key: "pr" fmt: "毫米"},
        {name: "体感温度" key: "ap" fmt: "°C"},
        {name: "风速" key: "ws" fmt: "公里/时"},
        {name: "紫外线" key: "uv" fmt: ""},
    ]
    let parts = []
    for it in items {
        let mark = ""
        if in_list(hits, it.name) { mark = "▲" }
        let w = worst_row(rows, it.key)
        if w == nil {
            parts.push(it.name + " 无")
        } else {
            let v = "" + w.v
            if it.key == "p" { v = int_str(w.v) }
            parts.push(it.name + mark + " " + v + it.fmt + "(" + w.h + ":00)")
        }
    }
    let out = parts[0]
    for i in parts.len() {
        if i > 0 { out = out + "、" + parts[i] }
    }
    return out
}

fn gap_days_str(ds){
    let t = today_str()
    let gap = days_of(ds) - days_of(t)
    return "" + round(gap) + " 天"
}

// ---------- 守护页:规则方案 ----------
// 映射自 Rust 版 rule_fallback_with_next_day(guardian_g2.rs:404-470):
// 高 → A改期(需次日同窗非高) + B室内;中 → A携带(词表内) + B室内;
// 低 → A保持原计划。
fn build_options(level, hits, pp_w, pr_w, ap_w, uv_w){
    let opts = []
    let cite = g_risk_line
    if level == "高" {
        // #24: 改期 = 最近几天同一时段里首个风险更低的日子(扫 5 天)
        let next = ""
        for i in 5 {
            let cand = shift_date(g_date, i + 1)
            if day_level(cand) != "高" { next = cand break }
        }
        let next_ok = next != ""
        if next_ok {
            opts.push({id: "A" act: "reschedule" label: "改期到 " + short_date(next) + " " + g_start why: "高风险。新时段 " + short_date(next) + ": " + day_line(next) + "; " + cite})
        }
        opts.push({id: (if opts.len() == 0 {"A"} else {"B"}) act: "mark_indoor" label: "改为室内" why: "高风险:触发 " + join_hits(hits) + "; 改为室内。" + cite})
    }
    elif level == "中" {
        let carry = []
        for h in hits {
            if h == "降水概率" || h == "小时降水量" { if !in_list(carry, "雨具") { carry.push("雨具") } }
            if h == "体感温度" && ap_w != nil && ap_w.v >= 32.0 { if !in_list(carry, "补水") { carry.push("补水") } }
            if h == "体感温度" && ap_w != nil && ap_w.v <= 0.0 { if !in_list(carry, "保暖衣物") { carry.push("保暖衣物") } }
            if h == "UV指数" { if !in_list(carry, "防晒") { carry.push("防晒") } }
        }
        if carry.len() > 0 {
            let note = join_list(carry)
            opts.push({id: "A" act: "add_checklist" label: "携带:" + note why: "中风险:触发 " + join_hits(hits) + "; 建议携带。" + cite})
        }
        opts.push({id: (if opts.len() == 0 {"A"} else {"B"}) act: "mark_indoor" label: "改为室内" why: "中风险:触发 " + join_hits(hits) + "; 可改为室内。" + cite})
    }
    else {
        opts.push({id: "A" act: "keep" label: "保持原计划" why: "低风险:" + cite})
    }
    g_opts = opts
    g_sel = 0
}

// 某日期同窗(仅按小时,跨天不折返)的风险等级
fn day_level(ds){
    let hall = guard_wx().hall
    let sh = g_start.split(":")[0].to_f64()
    let span = ceil(g_dur / 60.0)
    let lv = "低"
    for k in span + 1 {
        let h = sh + k
        if h > 23 { break }
        for r in hall {
            if r.ds == ds && r.h.to_f64() == h {
                if r.p != nil && r.p >= 60.0 { lv = "高" }
                elif r.p != nil && r.p >= 30.0 { if lv == "低" { lv = "中" } }
                if r.pr != nil && r.pr >= 2.0 { lv = "高" }
                elif r.pr != nil && r.pr >= 0.5 { if lv == "低" { lv = "中" } }
                if r.ap != nil && (r.ap >= 35.0 || r.ap <= 0.0) { lv = "高" }
                elif r.ap != nil && r.ap >= 32.0 { if lv == "低" { lv = "中" } }
                if r.ws != nil && r.ws >= 38.0 { lv = "高" }
                elif r.ws != nil && r.ws >= 28.0 { if lv == "低" { lv = "中" } }
                break
            }
        }
    }
    return lv
}

fn day_line(ds){
    let hall = guard_wx().hall
    let sh = g_start.split(":")[0].to_f64()
    let span = ceil(g_dur / 60.0)
    let mpp = nil
    for k in span + 1 {
        let h = sh + k
        if h > 23 { break }
        for r in hall {
            if r.ds == ds && r.h.to_f64() == h {
                if r.p != nil {
                    if mpp == nil || r.p > mpp { mpp = r.p }
                }
                break
            }
        }
    }
    if mpp == nil { return "暂无该时段数据" }
    return "降水概率 " + int_str(mpp) + "%,风险" + day_level(ds)
}

fn in_list(list, v){
    for x in list { if x == v { return true } }
    return false
}

fn join_hits(hits){
    if hits.len() == 0 { return "无" }
    let out = hits[0]
    for i in hits.len() { if i > 0 { out = out + "、" + hits[i] } }
    return out
}

fn join_list(list){
    let out = list[0]
    for i in list.len() { if i > 0 { out = out + "、" + list[i] } }
    return out
}

// ---------- 守护页:确认执行 / 幂等 / 核验 ----------

// #28-4 伴生:路径被目录占用等损坏情形下,fs.exists 为真但 fs.read 抛错
// (实测 [E] file not found)。fs.list 里目录以 / 结尾——只读真文件。
fn file_ok(name){
    let names = fs.list(".")
    for n in names {
        if n == name + "/" { return false }
        if n == name { return true }
    }
    return false
}

// #28-4: fs.write 对被目录占用的路径是 isolate trap(实测 byte-range panic),
// 返回值检查来不及执行——写前预检目录占用,避开 panic 路径。
fn path_blocked(name){
    let names = fs.list(".")
    for n in names {
        if n == name + "/" { return true }
    }
    return false
}

fn load_plans(){
    g_plans = []
    g_ledger = []
    if file_ok("plans.json") {
        let v = fs.read("plans.json").parse_json()
        if v != nil && has_key(v, "list") { g_plans = v.list }
    }
    if file_ok("ledger.json") {
        let v2 = fs.read("ledger.json").parse_json()
        if v2 != nil && has_key(v2, "entries") { g_ledger = v2.entries }
    }
}

fn save_plans(){ fs.write("plans.json", {list: g_plans}.to_json()) }
fn save_ledger(){ fs.write("ledger.json", {entries: g_ledger}.to_json()) }

fn ledger_seq(){
    if g_ledger.len() == 0 { return 1 }
    let mx = 0
    for e in g_ledger { if e.seq > mx { mx = e.seq } }
    return mx + 1
}

// 执行动作(不经过任何模型):直接改行程簿条目
fn apply_action(plan, opt){
    if opt.act == "reschedule" {
        plan = redate_plan(plan, opt)
        plan.rescheduled = true
    }
    elif opt.act == "mark_indoor" { plan.indoor = true }
    elif opt.act == "add_checklist" {
        let items = opt.label.split(":")
        if items.len() >= 2 {
            let its = items[1].split("、")
            for it in its {
                let t = it.trim()
                if t != "" && !in_list(plan.checklist, t) { plan.checklist.push(t) }
            }
        }
    }
    return plan
}

fn redate_plan(plan, opt){
    // label 形如「改期到 10/3 周六 09:00」→ 从 short_date 反解
    let m = regex("([0-9]{1,2})/([0-9]{1,2})", "").exec(opt.label)
    if m != nil && m.captures.len() >= 3 {
        let mo = m.captures[1].to_f64()
        let d = m.captures[2].to_f64()
        let y = year_of(today_str())
        // short_date 无年份:跨年时按预报窗口归属(10/3 → 当年)
        plan.date = fmt_ds(y, mo, d)
    }
    return plan
}

fn g_confirm(){
    // 幂等:同一方案(action 键)再确认 → 不重复执行。stage 已是 3 时
    // 也要回答「未重复」而不是静默 return(#24 验收点)。
    if g_exec_fail != "" {
        // 重试:上次失败已回滚内存,直接重走
        g_exec_fail = ""
    }
    if (g_stage != 2 && g_stage != 3) || g_opts.len() == 0 { return }
    let opt = g_opts[g_sel]
    let act_id = plan_key(opt)
    if act_id == g_last_action_id {
        g_note = "已执行,未重复"
        render_guard()
        return
    }
    if g_stage != 2 { return }
    if path_blocked("plans.json") || path_blocked("ledger.json") {
        g_exec_fail = "存储不可用(行程簿/台账文件无法写入),未执行;排除后点「确认执行」重试"
        render_guard()
        return
    }
    let plan = {id: "p" + time_now() place: g_place date: g_date start: g_start dur: g_dur indoor: false rescheduled: false checklist: [] done: false}
    let after = apply_action(plan, opt)
    g_plans.push(after)
    // #28-4: 持久化失败 → 不记成功台账,给原因,可重试(再点确认)
    let w1 = fs.write("plans.json", {list: g_plans}.to_json())
    if w1 != nil {
        // 错误值不能拼进字符串(实测 isolate panic: byte range)——固定文案
        g_plans.pop()
        g_exec_fail = "行程簿保存失败(无法写入 plans.json),未执行;再点「确认执行」重试"
        render_guard()
        return
    }
    let seq = ledger_seq()
    g_ledger.push({seq: seq at: fmt_dt(wx.time) kind: "exec" action_id: act_id detail: opt.label + " → 已应用;执行前 " + g_date + " " + g_start + " · 户外"})
    let w2 = fs.write("ledger.json", {entries: g_ledger}.to_json())
    if w2 != nil {
        g_plans.pop()
        g_ledger.pop()
        g_exec_fail = "台账保存失败(无法写入 ledger.json),未执行;再点「确认执行」重试"
        render_guard()
        return
    }
    g_last_action_id = act_id
    g_stage = 3
    g_step = 4
    g_note = "已执行(台账 #" + seq + ")· 已到第④步,按「核验」重新取数比对"
    render_guard()
}

fn plan_key(opt){
    return opt.act + ":" + g_date + ":" + g_start + ":" + g_dur + ":" + opt.label
}

// 核验:重新拉取当前城市预报,读回行程簿最后一条,比对 + 改期新窗非高
fn g_verify(){
    if g_stage != 3 { return }
    if wx == nil { g_note = "数据未就绪" render_guard() return }
    let p = g_plans[g_plans.len()-1]
    let lv = day_level_of(p.date, p.start, p.dur)
    let readback = p.place + " " + short_date(p.date) + " " + p.start
    let verdict = ""
    // #27-2: 「新时段不是高风险」只用于改期(reschedule)。室内/携带/保持
    // 核验「读回的计划与执行内容一致」;风险仍高时另起一行提醒,不判失败。
    if p.indoor {
        g_verify_line = "核验通过 · 读回 " + readback + " · 室内"
        g_note = "核验通过"
        verdict = "通过(室内)"
    }
    elif has_key(p, "rescheduled") && p.rescheduled {
        if lv == "高" {
            g_verify_line = "核验未通过 · 读回 " + readback + " · 新时段风险高"
            g_note = "核验未通过,可重选方案"
            verdict = "未通过(新时段风险高)"
        } else {
            g_verify_line = "核验通过 · 读回 " + readback + " · 新时段风险" + lv
            g_note = "核验通过"
            verdict = "通过(新时段风险" + lv + ")"
        }
    }
    else {
        let check_txt = ""
        if p.checklist != nil && p.checklist.len() > 0 { check_txt = " · 携带:" + join_list(p.checklist) }
        g_verify_line = "核验通过 · 读回 " + readback + check_txt
        g_note = "核验通过"
        verdict = "通过(读回一致" + check_txt + ")"
        if lv == "高" {
            g_verify_line = g_verify_line + "\n风险提醒:计划时段风险仍为高,建议改期或改为室内"
            verdict = verdict + ";风险仍高"
        }
    }
    // #25-8:核验也记台账(kind=verify,结果+原因+数据时间)
    let seq = ledger_seq()
    g_ledger.push({seq: seq at: fmt_dt(wx.time) kind: "verify" action_id: "verify:" + p.id detail: "核验" + verdict + ";读回 " + p.place + " " + p.date + " " + p.start + ";数据时间 " + fmt_dt(wx.time)})
    save_ledger()
    render_guard()
}

fn day_level_of(ds, start, dur){
    let hall = guard_wx().hall
    let sh = start.split(":")[0].to_f64()
    let span = ceil(dur / 60.0)
    let lv = "低"
    for k in span + 1 {
        let h = sh + k
        if h > 23 { break }
        for r in hall {
            if r.ds == ds && r.h.to_f64() == h {
                if r.p != nil && r.p >= 60.0 { lv = "高" }
                elif r.p != nil && r.p >= 30.0 { if lv == "低" { lv = "中" } }
                if r.pr != nil && r.pr >= 2.0 { lv = "高" }
                elif r.pr != nil && r.pr >= 0.5 { if lv == "低" { lv = "中" } }
                if r.ap != nil && (r.ap >= 35.0 || r.ap <= 0.0) { lv = "高" }
                elif r.ap != nil && r.ap >= 32.0 { if lv == "低" { lv = "中" } }
                if r.ws != nil && r.ws >= 38.0 { lv = "高" }
                elif r.ws != nil && r.ws >= 28.0 { if lv == "低" { lv = "中" } }
                break
            }
        }
    }
    return lv
}

let g_undo_plan = nil      // #29-5: 3 秒内可撤销的删除
let g_undo_idx = 0
let g_undo_timer = nil

fn plan_row_tap(i){
    if g_undo_plan != nil {
        undo_del()
        return
    }
    del_plan(i)
}

fn del_plan(i){
    if g_undo_plan != nil {
        // 上一次撤销窗口未关:先落定(视为删除)
        stop_timer(g_undo_timer)
        g_undo_plan = nil
    }
    g_undo_idx = i
    g_undo_plan = g_plans[i]
    let kept = []
    for j in g_plans.len() { if j != i { kept.push(g_plans[j]) } }
    g_plans = kept
    save_plans()
    g_note = "已删除;3 秒内点「撤销删除」可恢复"
    g_undo_timer = start_timeout(3.0, || undo_close())
    render_guard()
}

fn undo_close(){
    g_undo_plan = nil
    render_guard()
}

fn undo_del(){
    if g_undo_plan == nil { return }
    stop_timer(g_undo_timer)
    // 插回原位(超范围则放末尾)
    let out = []
    let placed = false
    for j in g_plans.len() {
        if j == g_undo_idx { out.push(g_undo_plan) placed = true }
        out.push(g_plans[j])
    }
    if !placed { out.push(g_undo_plan) }
    g_plans = out
    g_undo_plan = nil
    save_plans()
    g_note = "已撤销删除"
    render_guard()
}

// ---------- 守护页:输入/编辑/选案 ----------

fn g_start_input(text){
    g_input = text
    if wx == nil {
        // #27-1: 预报未到(刚启动/断网)→ 不发 agent,不卡「正在…」,明确提示
        g_src_parse = "规则"
        g_note = "天气数据还没就绪,稍等再试"
        render_guard()
        return
    }
    if g_agent_state == 2 {
        g_src_parse = "规则"
        g_parse()
        g_note = agent_unavailable_note() + " · " + g_note
        render_guard()
        return
    }
    g_note = "正在请 agent 解析…"
    render_guard()
    let today = today_str()
    let prompt = "今天是 " + today + "(YYYY-MM-DD)。请只回 JSON,字段固定为 {place,date,start,duration_min,missing[]}:place 是地点标签(2-6 字,不含活动词),date 是 YYYY-MM-DD,start 是 HH:MM(24 小时制),duration_min 是分钟数(15-720),missing 是缺失项数组(地点/时间)。用户原话:" + text
    agent_ask("parse", prompt)
}

// 解析卡读回(编辑生效):short_date 反解日期,HH:MM/分钟读回
fn g_reassess(){
    let d = ui.g_date_box.text().trim()
    let t = ui.g_time_box.text().trim()
    let du = ui.g_dur_box.text().trim()
    g_place = ui.g_place_box.text().trim()
    // 「10/3 周六」→ 当年 M/D
    let m = regex("([0-9]{1,2})/([0-9]{1,2})", "").exec(d)
    if m != nil && m.captures.len() >= 3 {
        g_date = fmt_ds(year_of(today_str()), m.captures[1].to_f64(), m.captures[2].to_f64())
    }
    let tv = regex("([0-9]{1,2}):([0-9]{2})", "").exec(t)
    if tv != nil && tv.captures.len() >= 3 {
        let h = tv.captures[1].to_f64()
        let mi = tv.captures[2].to_f64()
        if h <= 23.0 && mi <= 59.0 { g_start = fmt_hm(h, mi) }
    }
    let nv = du.to_f64()
    if nv >= 15.0 && nv <= 720.0 { g_dur = round(nv) }
    g_stage = 1
    g_verify_line = ""
    g_assess()
}

fn g_pick(i){
    if i < g_opts.len() {
        g_sel = i
        ui.g_opt_rows.render()
    }
}

fn checklist_str(p){
    if p.checklist == nil || p.checklist.len() == 0 { return "" }
    return " · 携带:" + join_list(p.checklist)
}

// ---------- 守护页:导航与渲染 ----------

fn open_guard(){
    g_screen = "guard"
    load_plans()
    ui.app_head.set_visible(false)
    ui.note_lbl.set_visible(false)
    ui.guard_hr.set_visible(false)
    ui.home_page.set_visible(false)
    ui.guard_page.set_visible(true)
    render_guard()
}

fn back_home(){
    g_screen = "home"
    ui.app_head.set_visible(true)
    ui.note_lbl.set_visible(true)
    ui.guard_hr.set_visible(true)
    ui.guard_page.set_visible(false)
    ui.home_page.set_visible(true)
    render_home()
}

// #31: 分步导航(不依赖宿主滚动;每步内容自适应 ≤~420px)
fn gos(n){
    g_step = n
    // #33: 输入行跟着步①走(gos 不经过 render_guard,须在此显式同步)
    ui.g_input_row.set_visible(n == 1)
    ui.g_s1.set_visible(n == 1)
    ui.g_s2.set_visible(n == 2)
    ui.g_s3.set_visible(n == 3)
    ui.g_s4.set_visible(n == 4)
}

fn render_guard(){
    ui.g_note_lbl.set_text(g_note)
    // #33-4: 标题反映「本次方案/解析」的真实来源——键在来源标志而非 state
    // (点「改用规则」后 state=2,但本次解析若来自 agent,标题仍应如实说明)
    if g_src_opts == "agent" { ui.g_title.set_text("行程守护 · agent 版") }
    elif g_src_parse == "agent" { ui.g_title.set_text("行程守护 · 解析来自 agent · 方案由规则给出") }
    else { ui.g_title.set_text("行程守护 · 规则版(无 agent)") }
    ui.g_rules_btn.set_visible(g_agent_reject)
    // #33-2: 文档化 API 只有 set_visible/set_text——pending 时藏评估按钮,行内提示进度
    // #33-2: 请求期间藏按钮防重复点击;进度文案走 g_note(「正在请 agent 出方案…」)
    ui.g_assess_btn.set_visible(!g_opt_pending && !g_agent_pending)
    ui.g_execfail_lbl.set_visible(g_exec_fail != "")
    ui.g_execfail_lbl.set_text(g_exec_fail)
    ui.g_parse_src.set_text("解析卡(来源:" + g_src_parse + " · 可修改后重新评估)")
    ui.g_opt_src.set_text("方案卡(来源:" + g_src_opts + " · 单击选择)")
    // #31: 卡片常驻,按步容器显隐(不依赖宿主滚动,也不靠一次性 set_visible)
    // #33: 输入行只在步①显示——回①可重新解析;②③④省 42px
    ui.g_input_row.set_visible(g_step == 1)
    ui.g_s1.set_visible(g_step == 1)
    ui.g_s2.set_visible(g_step == 2)
    ui.g_s3.set_visible(g_step == 3)
    ui.g_s4.set_visible(g_step == 4)
    if g_stage >= 1 {
        ui.g_place_box.set_text(g_place)
        ui.g_date_box.set_text(short_date(g_date))
        ui.g_time_box.set_text(g_start)
        ui.g_dur_box.set_text("" + g_dur)
    }
    if g_stage >= 2 && g_no_forecast == "" {
        ui.g_risk_line.set_text("风险:" + g_risk_level + " · " + g_risk_line)
        ui.g_risk_src.set_text(g_risk_src)
    } else {
        ui.g_risk_line.set_text("还没有评估")
        ui.g_risk_src.set_text("")
    }
    ui.g_nofc_lbl.set_text(g_no_forecast)
    ui.g_opt_rows.render()
    ui.g_confirm_btn.set_visible(g_stage >= 2 && g_opts.len() > 0)
    ui.g_verify_btn.set_visible(g_stage == 3)
    ui.g_verify_line.set_text(g_verify_line)
    ui.g_plan_rows.render()
}


// ---------- S3:agent 通路(octos.session.open / octos.turn.start) ----------
// 原则:模型只写理解和方案,不写事实;执行与核验不经过模型(沿用 S2)。
// 协议出处:docs/AI-SERVICES.md「A minimal call」+ HOST-SERVICES.md
// (card-host 无 octos 服务,host.request 立即回 no service answers,不挂起)。

// #27-1: 台账时间不依赖预报(wx 可能为 nil,如刚启动/断网)。用预报时间,没有则应用时间。
fn now_stamp(){
    if wx == nil { return fmt_dt(now_local_iso()) }
    return fmt_dt(wx.time)
}
fn now_local_iso(){
    // 应用自己的时间:local_time 在 card-host 是 UTC,如实标注 Z
    let t = local_time()
    let mo = t.month
    let da = t.day
    let ho = t.hour
    let mi = t.minute
    let ms = "" + mo
    let ds = "" + da
    let hs = "" + ho
    let mis = "" + mi
    if mo < 10.0 { ms = "0" + mo }
    if da < 10.0 { ds = "0" + da }
    if ho < 10.0 { hs = "0" + ho }
    if mi < 10.0 { mis = "0" + mi }
    return "" + t.year + "-" + ms + "-" + ds + "T" + hs + ":" + mis
}

fn agent_ledger(chan, good, reason){
    let seq = ledger_seq()
    let d = "不合规:" + reason
    if good { d = "合规采用" }
    g_ledger.push({seq: seq at: now_stamp() kind: "agent" action_id: chan detail: d})
    save_ledger()
}

fn agent_unavailable_note(){
    return "agent 不可用,方案由规则给出"
}

// #35-2: 超时/限流是「这一次没答上」,不是不可用
fn agent_timeout_note(){
    return "这次助手没及时回复,已按规则处理"
}

// #35-2: 只有「服务不存在」才判整个会话不可用
fn agent_no_service(err){
    return ("" + err).search("no service") >= 0
}

// 回退提示按状态选:服务不存在 → 不可用;其余 → 本次没及时回复
fn agent_fallback_note(){
    if g_agent_state == 2 { return agent_unavailable_note() }
    return agent_timeout_note()
}

// 30 秒超时:回调未至 → 只回退这一次,不关整个会话的 agent(#26-6 → #35-2)
fn agent_timeout(){
    if !g_agent_pending { return }
    g_agent_pending = false
    if g_agent_timer != nil { stop_timer(g_agent_timer) g_agent_timer = nil }
    agent_ledger(g_agent_chan, false, "30 秒无响应")
    if g_agent_chan == "parse" {
        g_src_parse = "规则"
        g_parse()
        // #35-1: 前缀拼接,保留规则解析的 note(缺项、还提到:…)
        g_note = agent_timeout_note() + " · " + g_note
        render_guard()
    } else {
        g_opt_pending = false
        g_opts = []
        build_options(g_risk_level, [], nil, nil, nil, nil)
        g_src_opts = "规则"
        g_note = "风险:" + g_risk_level + " · " + agent_timeout_note()
        render_guard()
    }
}

// 数字校验:why 里的每个数字都要能在事实里找到(±0.5 或 ±1%)(#26-4)
fn num_ok(v, facts){
    for f in facts {
        let d = abs(v - f)
        if d <= 0.5 { return true }
        if abs(f) >= 1.0 && d / abs(f) * 100.0 <= 1.0 { return true }
    }
    return false
}

// #33-1: why 里的时间/日期 token 先剥除,再对剩余数字对照事实。
// 允许的时间集合:计划起止窗内整点(HH 与 H 两种写法)、改期目标日的同窗整点;
// 允许的日期集合:计划日与改期目标日的 M/D、M、D;年份(2026)一并不算编造。
fn resched_target(){
    let next_t = ""
    for i in 5 {
        let cand = shift_date(g_date, i + 1)
        if day_level(cand) != "高" { next_t = cand break }
    }
    return next_t
}

fn window_hours(){
    let sh = g_start.split(":")[0].to_f64()
    let span = ceil(g_dur / 60.0)
    let out = []
    for k in span + 1 {
        let h = sh + k
        if h > 23 { break }
        out.push(h)
    }
    return out
}

fn strip_time_tokens(text){
    // #33-1: 时间/日期 token 按字节区间整体豁免。捕获组路径不能用:
    // match_all 的 captures 在多字节输入下触发 string.rs:795 的区间 panic
    // (m6 最小探针实证,start 39 > end 37)——改用无捕获组正则 + 手工解析
    // token 值(split/strip)取成分,再按 index/len 建豁免区间。
    let dates = [g_date]
    for i in 5 {
        dates.push(shift_date(g_date, i + 1))
    }
    let d_ok = []
    for ds in dates {
        let parts = ds.split("-")
        if parts.len() >= 3 {
            d_ok.push([parts[1].to_f64(), parts[2].to_f64()])
        }
    }
    let h_ok = window_hours()
    let ranges = []
    // HH:MM
    let re_t = regex("[0-9]{1,2}:[0-9]{2}", "")
    for m in text.match_all(re_t) {
        let ps = m.value.split(":")
        if ps.len() >= 2 {
            let h = ps[0].to_f64()
            if in_list(h_ok, h) { ranges.push({a: m.index, b: m.index + m.value.len()}) }
        }
    }
    // H点 / H时
    let re_h = regex("[0-9]{1,2}[点时]", "")
    for m in text.match_all(re_h) {
        let v = m.value.split("点")[0]
        v = v.split("时")[0]
        let h = v.to_f64()
        if in_list(h_ok, h) { ranges.push({a: m.index, b: m.index + m.value.len()}) }
    }
    // M/D
    let re_md = regex("[0-9]{1,2}/[0-9]{1,2}", "")
    for m in text.match_all(re_md) {
        let ps = m.value.split("/")
        if ps.len() >= 2 {
            let mo = ps[0].to_f64()
            let da = ps[1].to_f64()
            for pd in d_ok {
                if pd[0] == mo && pd[1] == da { ranges.push({a: m.index, b: m.index + m.value.len()}) }
            }
        }
    }
    // M月D日
    let re_mdc = regex("[0-9]{1,2}月[0-9]{1,2}日", "")
    for m in text.match_all(re_mdc) {
        let v = m.value.replace("月", "/")
        let t2 = v.strip_suffix("日")
        if t2 != nil {
            let ps = t2.split("/")
            if ps.len() >= 2 {
                let mo = ps[0].to_f64()
                let da = ps[1].to_f64()
                for pd in d_ok {
                    if pd[0] == mo && pd[1] == da { ranges.push({a: m.index, b: m.index + m.value.len()}) }
                }
            }
        }
    }
    // 剩余数字:落在任一豁免区间内 → 跳过;否则对照因子值
    let re = regex("[0-9]+[.]?[0-9]*", "")
    let keep = []
    for m in text.match_all(re) {
        let v = m.value.to_f64()
        if v >= 1000.0 { continue }
        let na = m.index
        let nb = m.index + m.value.len()
        let hit = false
        for rg in ranges {
            if na >= rg.a && nb <= rg.b { hit = true break }
        }
        if hit { continue }
        keep.push(v)
    }
    return keep
}

fn reply_nums(text){
    // str.match_all(pat)(string.rs:374):pat 必须是 regex 对象(非模式字符串)
    let out = []
    let re = regex("[0-9]+[.]?[0-9]*", "")
    let ms = text.match_all(re)
    for m in ms {
        let v = m.value.to_f64()
        if v >= 0.0 { out.push(v) }
    }
    return out
}

fn fact_nums(){
    let hall = guard_wx().hall
    let sh = g_start.split(":")[0].to_f64()
    let span = ceil(g_dur / 60.0)
    let out = []
    for k in span + 1 {
        let h = sh + k
        if h > 23 { break }
        for r in hall {
            if r.ds == g_date && r.h.to_f64() == h {
                if r.p != nil { out.push(r.p) }
                if r.pr != nil { out.push(r.pr) }
                if r.ap != nil { out.push(r.ap) }
                if r.ws != nil { out.push(r.ws) }
                if r.uv != nil { out.push(r.uv) }
                out.push(h)
                break
            }
        }
    }
    out.push(g_dur)
    return out
}

// 回复总检:不能带 URL
fn reply_has_url(text){
    return text.search("http") >= 0
}

// 解析回复校验:只允许 {place,date,start,duration_min,missing}
fn agent_parse_ok(text){
    if reply_has_url(text) { return {is_good: false why: "回复含 URL"} }
    let o = text.parse_json()
    if o == nil { return {is_good: false why: "不是合规 JSON"} }
    let want = ["place","date","start","duration_min","missing"]
    for k in want {
        if !has_key(o, k) { return {is_good: false why: "缺字段 " + k} }
    }
    let n = 0
    for k v in o { n = n + 1 }
    if n != 5 { return {is_good: false why: "有多余字段"} }
    // #34-1: 字段先归一化为字符串再检查(脚本无 typeof;探针语义:
    // ""+nil→""、""+数字→数字串、""+对象→"[ScriptObject]"、""+数组→"[Unknown]"。
    // 类型错误(对象/数组)会得到哨兵串,正则不匹配 → 不合规,绝不让
    // regex.test 直接吃到非字符串(operator 卡死根因)。
    let place_s = "" + o.place
    let date_s = "" + o.date
    let start_s = "" + o.start
    let dur_s = "" + o.duration_min
    // #34-③: 嵌套对象/数组字段 → 哨兵串含「[」→ 判不合规(不得蒙混过关)
    for sv in [place_s, date_s, start_s, dur_s] {
        if sv.search("[") >= 0 { return {is_good: false why: "字段类型错误(对象/数组):" + sv} }
    }
    if "" + o.missing != "[Unknown]" { return {is_good: false why: "missing 非数组"} }
    let miss = []
    for m in o.missing { miss.push("" + m) }
    // 缺项字段允许空或 nil(#34-1):missing 里声明了就按缺项放行
    let dr = regex("[0-9]{4}-[0-9]{2}-[0-9]{2}", "")
    let tr = regex("[0-9]{2}:[0-9]{2}", "")
    let nr = regex("[0-9]+[.]?[0-9]*", "")
    if date_s == "" || start_s == "" || dur_s == "" {
        // 空字段必须有对应 missing 声明,否则不合规
        if date_s == "" && !in_list(miss, "date") { return {is_good: false why: "date 为空且未声明缺项"} }
        if start_s == "" && !in_list(miss, "start") { return {is_good: false why: "start 为空且未声明缺项"} }
        if dur_s == "" && !in_list(miss, "duration_min") { return {is_good: false why: "duration_min 为空且未声明缺项"} }
    } else {
        if !dr.test(date_s) { return {is_good: false why: "date 非 YYYY-MM-DD"} }
        if !tr.test(start_s) { return {is_good: false why: "start 非 HH:MM"} }
        if !nr.test(dur_s) { return {is_good: false why: "duration_min 非数字"} }
        let du = dur_s.to_f64()
        if !(du >= 15.0 && du <= 720.0) { return {is_good: false why: "duration_min 越界"} }
    }
    // 空地点放行为缺项(解析卡留空提示补全),不判不合规
    return {is_good: true o: {place: place_s date: date_s start: start_s duration_min: dur_s missing: miss}}
}

// 方案回复校验:{options:[{action,why,checklist}]},1-3 项,四条规则全查
fn agent_options_ok(text, facts){
    if reply_has_url(text) { return {is_good: false why: "回复含 URL"} }
    let o = text.parse_json()
    if o == nil { return {is_good: false why: "不是合规 JSON"} }
    if !has_key(o, "options") { return {is_good: false why: "缺 options"} }
    let n = 0
    for k v in o { n = n + 1 }
    if n != 1 { return {is_good: false why: "有多余字段"} }
    // #34-2: 数组与类型守卫(哨兵串判定),任何畸形回复都不允许走到运行时错误
    if "" + o.options != "[Unknown]" { return {is_good: false why: "options 非数组"} }
    let opts = o.options
    if opts.len() < 1 || opts.len() > 3 { return {is_good: false why: "options 数量 1-3"} }
    let acts = ["reschedule","mark_indoor","add_checklist","keep"]
    let vocab = ["雨具","补水","保暖衣物","防晒"]
    for op in opts {
        let m = 0
        for k v in op { m = m + 1 }
        if m != 3 { return {is_good: false why: "option 有多余/缺失字段"} }
        if !in_list(acts, "" + op.action) { return {is_good: false why: "action 非法:" + ("" + op.action)} }
        if "" + op.checklist != "[Unknown]" { return {is_good: false why: "checklist 非数组"} }
        for c in op.checklist {
            if !in_list(vocab, "" + c) { return {is_good: false why: "checklist 越词表:" + ("" + c)} }
        }
        // #34-③ + #33-1: why 为对象/数组 → 不合规;否则剥时间/日期 token 后对照因子值
        let why_s = "" + op.why
        if why_s.search("[") >= 0 { return {is_good: false why: "why 类型错误(对象/数组)"} }
        for v in strip_time_tokens(why_s) {
            if !num_ok(v, facts) { return {is_good: false why: "why 含事实外数字 " + v} }
        }
    }
    return {is_good: true opts: opts}
}

// agent 方案 → g_opts(执行参数由代码定,不取自模型)
fn agent_opts_to_g(opts){
    let out = []
    let ids = ["A","B","C"]
    let resched_label = ""
    let next = ""
    for i in 5 {
        let cand = shift_date(g_date, i + 1)
        if day_level(cand) != "高" { next = cand break }
    }
    if next != "" { resched_label = "改期到 " + short_date(next) + " " + g_start }
    for i op in opts {
        let label = op.why
        if op.action == "reschedule" && resched_label != "" { label = resched_label }
        if op.action == "mark_indoor" { label = "改为室内" }
        if op.action == "keep" { label = "保持原计划" }
        if op.action == "add_checklist" {
            let items = ""
            for c in op.checklist {
                if items != "" { items = items + "、" }
                items = items + c
            }
            label = "携带:" + items
        }
        out.push({id: ids[i] act: op.action label: label why: op.why})
    }
    return out
}

// 统一入口:先 session.open,再 turn.start;回包走校验
fn agent_ask(chan, prompt){
    if g_agent_state == 2 {
        agent_fallback(chan, agent_unavailable_note())
        return
    }
    g_agent_chan = chan
    g_agent_reject = false
    g_agent_pending = true
    g_agent_timer = start_timeout(30.0, || agent_timeout())
    host.request("octos.session.open", {}, fn(sess){
        if !sess.is_ok {
            if agent_no_service(sess.error) { g_agent_state = 2 }
            g_agent_pending = false
            if g_agent_timer != nil { stop_timer(g_agent_timer) g_agent_timer = nil }
            agent_ledger(chan, false, "session.open:" + sess.error)
            agent_fallback(chan, agent_fallback_note())
            return
        }
        host.request("octos.turn.start", {text: prompt}, fn(r){
            g_agent_pending = false
            if g_agent_timer != nil { stop_timer(g_agent_timer) g_agent_timer = nil }
            if !r.is_ok {
                if agent_no_service(r.error) { g_agent_state = 2 }
                agent_ledger(chan, false, "turn.start:" + r.error)
                agent_fallback(chan, agent_fallback_note())
                return
            }
            g_agent_state = 1
            agent_reply(chan, r.data.text)
        })
    })
}

fn agent_use_rules_now(){
    g_agent_state = 2
    g_agent_reject = false
    if g_agent_chan == "parse" {
        g_src_parse = "规则"
        g_parse()
        g_note = agent_unavailable_note() + " · " + g_note
    } else {
        g_src_opts = "规则"
        build_options(g_risk_level, [], nil, nil, nil, nil)
        g_note = "风险:" + g_risk_level + " · " + agent_unavailable_note()
    }
    render_guard()
}

// #28-5: 普通用户能看懂的不合规文案
fn agent_bad_note(technical){
    return "助手回复没有通过检查(" + technical + ")。可以点「改用规则」继续,不影响使用"
}

fn agent_fallback(chan, pfx){
    g_opt_pending = false
    if chan == "parse" {
        g_src_parse = "规则"
        g_parse()
        g_note = pfx + " · " + g_note
        render_guard()
    } else {
        g_src_opts = "规则"
        build_options(g_risk_level, [], nil, nil, nil, nil)
        g_note = "风险:" + g_risk_level + " · " + pfx
        render_guard()
    }
}

fn agent_reply(chan, text){
    if chan == "parse" {
        let v = agent_parse_ok(text)
        if !v.is_good {
            g_agent_bad = g_agent_bad + 1
            agent_ledger(chan, false, v.why)
            agent_fallback(chan, "助手回复没通过检查(" + v.why + "),已按规则处理")
            return
        }
        g_agent_bad = 0
        agent_ledger(chan, true, "")
        let o = v.o
        // #34-3: agent 通路同样处理多地点(取第一个,其余写提示)
        let mp = split_multi_place(o.place)
        g_place = mp.first
        let place_extra = mp.extra
        g_date = o.date
        g_start = o.start        // 缺项时为 "",解析卡留空提示补全
        // #34: duration 缺项时用默认 120,round("") 未定义
        let dmins = 120.0
        if o.duration_min != "" { dmins = o.duration_min.to_f64() }
        g_dur = round(dmins)
        g_stage = 1
        g_no_forecast = ""
        g_verify_line = ""
        g_src_parse = "agent"
        // #34: 缺项提示用中文字段名(与规则通路一致)
        let zh = {place: "地点" date: "日期" start: "时间" duration_min: "时长"}
        let miss = []
        for m in o.missing { miss.push(zh[m]) }
        if miss.len() > 0 {
            g_note = "agent 解析缺:" + join_list(miss) + " · 请在解析卡补全后再评估"
        } else {
            g_note = "agent 已解析 · 按「评估风险」继续"
        }
        if place_extra != "" { g_note = g_note + " · 还提到:" + place_extra + "(可在解析卡修改)" }
        render_guard()
    } else {
        let facts = fact_nums()
        let v = agent_options_ok(text, facts)
        if !v.is_good {
            g_agent_bad = g_agent_bad + 1
            agent_ledger(chan, false, v.why)
            if g_agent_bad >= 2 {
                agent_fallback(chan, agent_fallback_note())
                g_note = "助手连续两次没有通过检查(" + v.why + "),已改用规则方案"
                render_guard()
                return
            }
            g_note = agent_bad_note(v.why)
            g_agent_reject = true
            g_opt_pending = false
            g_step = 3   // #33: 拒绝后直达③——「改用规则」按钮所在页,提示才指得到
            render_guard()
            return
        }
        g_agent_bad = 0
        g_opt_pending = false
        agent_ledger(chan, true, "")
        g_opts = agent_opts_to_g(v.opts)
        g_sel = 0
        g_src_opts = "agent"
        g_stage = 2
        g_note = "风险:" + g_risk_level + " · 方案来自 agent(单击选择)"
        render_guard()
    }
}

// ---------- 启动 ----------

fn boot(){
    load_cities()
    ui.city_btn.set_text(cities[cur].name + " 切换")
    refresh()
    if refresh_timer == nil { refresh_timer = start_interval(900.0, || refresh()) }
}

start_timeout(0.05, || boot())

let ink = #x1c1c1e
let secondary = #x8e8e93
let hairline = #xe5e5ea
SolidView{width: Fill height: Fill flow: Down padding: 16 spacing: 10 draw_bg.color: #xffffff
    app_head := View{width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5}
        Label{text: "行程天气" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 22}}
        ButtonFlat{text: "行程守护" height: 36 padding: Inset{left: 12 right: 12} on_click: || open_guard()
            draw_bg +: {border_radius: 18.0 color: #x007aff color_hover: #x0a84ff color_down: #x0062cc border_size: 0.0}
            draw_text +: {color: #xffffff color_hover: #xffffff color_down: #xffffff}}
        city_btn := ButtonFlat{text: "深圳 切换" height: 36 padding: Inset{left: 14 right: 14} on_click: || toggle_panel()
            draw_bg +: {border_radius: 18.0 color: #xf2f2f7 color_hover: #xe8e8ed color_down: #xdcdce2 border_size: 0.0}
            draw_text +: {color: ink color_hover: ink color_down: ink}}
    }
    note_lbl := Label{visible: true width: Fill text: "" draw_text.color: secondary draw_text.text_style.font_size: 11}
    panel := View{visible: false width: Fill height: Fit flow: Down spacing: 8
        View{width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5}
            sbox := TextInput{width: Fill height: 36 empty_text: "搜索城市,如:成都 / 朝阳"
                on_return: |text| do_search(text)
                draw_bg +: {color: #xf2f2f7 color_hover: #xf2f2f7 color_focus: #xf2f2f7 color_empty: #xf2f2f7 border_radius: 18.0}
                draw_text +: {color: ink color_hover: ink color_focus: ink color_empty: secondary color_empty_hover: secondary}}
            ButtonFlat{text: "搜索" height: 36 padding: Inset{left: 14 right: 14} on_click: || do_search(ui.sbox.text())
                draw_bg +: {border_radius: 18.0 color: #x007aff color_hover: #x0a84ff color_down: #x0062cc border_size: 0.0}
                draw_text +: {color: #xffffff color_hover: #xffffff color_down: #xffffff}}
        }
        search_note := Label{width: Fill text: "" draw_text.color: secondary draw_text.text_style.font_size: 11}
        result_rows := View{width: Fill height: Fit flow: Down spacing: 4 on_render: || {
            for h in results {
                GestureView{width: Fill height: Fit padding: 8 on_tap: |x, y| pick_hit(h)
                    View{width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5}
                        Label{text: h.name draw_text.color: ink draw_text.text_style.font_size: 15}
                        Label{width: Fill text: h.country draw_text.color: secondary draw_text.text_style.font_size: 11}
                    }
                }
            }
        }}
        Hr{}
        Label{text: "已保存的城市" draw_text.color: secondary draw_text.text_style.font_size: 11}
        city_rows := View{width: Fill height: Fit flow: Down spacing: 4 on_render: || {
            for i c in cities {
                GestureView{width: Fill height: Fit padding: 8 on_tap: |x, y| select_city(i)
                    View{width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5}
                        Label{text: (if i == cur { "▶ " } else { "   " }) + c.name draw_text.color: ink draw_text.text_style.font_size: 15}
                        Label{width: Fill text: c.country draw_text.color: secondary draw_text.text_style.font_size: 11}
                    }
                }
            }
        }}
    }
    guard_hr := Hr{}
    home_page := View{width: Fill height: Fill flow: Down spacing: 10
    View{width: Fill height: Fit flow: Down spacing: 2
        temp_lbl := Label{text: "—" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 54}}
        cond_lbl := Label{text: "" draw_text.color: ink draw_text.text_style.font_size: 16}
        hilo_lbl := Label{text: "" draw_text.color: secondary draw_text.text_style.font_size: 13}
    }
    h_tabs := View{width: Fill height: Fit flow: Right spacing: 6
        h_today_btn := ButtonFlat{text: "今天" height: 30 padding: Inset{left: 12 right: 12} on_click: || htab(0)
            draw_bg +: {border_radius: 15.0 color: #xf2f2f7 color_hover: #xe8e8ed color_down: #xdcdce2 border_size: 0.0}
            draw_text +: {color: ink color_hover: ink color_down: ink}}
        h_days_btn := ButtonFlat{text: "10 天" height: 30 padding: Inset{left: 12 right: 12} on_click: || htab(1)
            draw_bg +: {border_radius: 15.0 color: #xf2f2f7 color_hover: #xe8e8ed color_down: #xdcdce2 border_size: 0.0}
            draw_text +: {color: ink color_hover: ink color_down: ink}}
    }
    h_today := View{width: Fill height: Fill flow: Down spacing: 10
    hours_hdr := Label{width: Fill text: "未来 24 小时 · 数据来自 Open-Meteo" draw_text.color: secondary draw_text.text_style.font_size: 11}
    hours_strip := ScrollXView{width: Fill height: Fit flow: Right spacing: 16 on_render: || {
        if wx == nil { Label{text: "暂无数据" draw_text.color: secondary draw_text.text_style.font_size: 12} }
        else {
            for h in wx.hours {
                View{width: Fit height: Fit flow: Down spacing: 2 align: Align{x: 0.5}
                    Label{text: h.h + "时" draw_text.color: secondary draw_text.text_style.font_size: 11}
                    Label{text: deg(h.t) draw_text.color: ink draw_text.text_style.font_size: 15}
                    Label{text: "降水 " + int_str(h.p) + "%" draw_text.color: secondary draw_text.text_style.font_size: 10}
                }
            }
        }
    }}
    }
    }
    h_days := View{visible: false width: Fill height: Fill flow: Down spacing: 10
    days_hdr := Label{width: Fill text: "10 天预报 · 数据来自 Open-Meteo" draw_text.color: secondary draw_text.text_style.font_size: 11}
    days_list := ScrollYView{width: Fill height: Fill flow: Down spacing: 8 on_render: || {
        if wx == nil { Label{text: "暂无数据" draw_text.color: secondary draw_text.text_style.font_size: 12} }
        else {
            for d in wx.days {
                View{width: Fill height: Fit flow: Right spacing: 10 align: Align{y: 0.5}
                    Label{width: 84 text: short_date(d.ds) draw_text.color: ink draw_text.text_style.font_size: 14}
                    Label{width: Fill text: wmo_zh(d.code) + " · 降水 " + int_str(d.pp) + "%" draw_text.color: secondary draw_text.text_style.font_size: 13}
                    Label{text: deg(d.hi) + " / " + deg(d.lo) draw_text.color: ink draw_text.text_style.font_size: 14}
                }
            }
        }
    }}
    }
// ---------- 守护页(#31 分步:每步 ≤~420px,不依赖宿主滚动) ----------
    guard_page := View{visible: false width: Fill height: Fill flow: Down spacing: 5
        View{width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5}
            ButtonFlat{text: "返回首页" height: 28 padding: Inset{left: 10 right: 10} on_click: || back_home()
                draw_bg +: {border_radius: 18.0 color: #xf2f2f7 color_hover: #xe8e8ed color_down: #xdcdce2 border_size: 0.0}
                draw_text +: {color: ink color_hover: ink color_down: ink}}
            g_title := Label{width: Fill text: "行程守护" draw_text.color: secondary draw_text.text_style.font_size: 12}
        }
        g_input_row := View{width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5}
            g_in := TextInput{width: Fill height: 32 empty_text: "例如:周六上午 9 点去深圳湾骑车,大概两小时"
                on_return: |text| g_start_input(text)
                draw_bg +: {color: #xf2f2f7 color_hover: #xf2f2f7 color_focus: #xf2f2f7 color_empty: #xf2f2f7 border_radius: 10.0}
                draw_text +: {color: ink color_hover: ink color_focus: ink color_empty: secondary color_empty_hover: secondary}}
            ButtonFlat{text: "解析" height: 32 padding: Inset{left: 14 right: 14} on_click: || g_start_input(ui.g_in.text())
                draw_bg +: {border_radius: 20.0 color: #x007aff color_hover: #x0a84ff color_down: #x0062cc border_size: 0.0}
                draw_text +: {color: #xffffff color_hover: #xffffff color_down: #xffffff}}
        }
        g_note_lbl := Label{width: Fill height: Fit text: "" draw_text.color: secondary draw_text.text_style.font_size: 10}
        View{width: Fill height: Fit flow: Right spacing: 6
            g_s1_btn := ButtonFlat{text: "① 解析" height: 26 padding: Inset{left: 8 right: 8} on_click: || gos(1)
                draw_bg +: {border_radius: 16.0 color: #xf2f2f7 color_hover: #xe8e8ed color_down: #xdcdce2 border_size: 0.0}
                draw_text +: {color: ink color_hover: ink color_down: ink}}
            g_s2_btn := ButtonFlat{text: "② 风险" height: 26 padding: Inset{left: 8 right: 8} on_click: || gos(2)
                draw_bg +: {border_radius: 16.0 color: #xf2f2f7 color_hover: #xe8e8ed color_down: #xdcdce2 border_size: 0.0}
                draw_text +: {color: ink color_hover: ink color_down: ink}}
            g_s3_btn := ButtonFlat{text: "③ 方案与执行" height: 26 padding: Inset{left: 8 right: 8} on_click: || gos(3)
                draw_bg +: {border_radius: 16.0 color: #xf2f2f7 color_hover: #xe8e8ed color_down: #xdcdce2 border_size: 0.0}
                draw_text +: {color: ink color_hover: ink color_down: ink}}
            g_s4_btn := ButtonFlat{text: "④ 行程簿" height: 26 padding: Inset{left: 8 right: 8} on_click: || gos(4)
                draw_bg +: {border_radius: 16.0 color: #xf2f2f7 color_hover: #xe8e8ed color_down: #xdcdce2 border_size: 0.0}
                draw_text +: {color: ink color_hover: ink color_down: ink}}
        }
        g_s1 := View{visible: true width: Fill height: Fill flow: Down spacing: 4
            g_parse_card := View{width: Fill height: Fit flow: Down spacing: 4
                g_parse_src := Label{text: "解析卡(来源:规则 · 可修改后重新评估)" draw_text.color: secondary draw_text.text_style.font_size: 11}
                View{width: Fill height: Fit flow: Right spacing: 6
                    Label{text: "地点" draw_text.color: ink draw_text.text_style.font_size: 13}
                    g_place_box := TextInput{width: Fill height: 27 empty_text: "如:深圳湾"
                        draw_bg +: {color: #xf2f2f7 color_hover: #xf2f2f7 color_focus: #xf2f2f7 color_empty: #xf2f2f7 border_radius: 8.0}
                        draw_text +: {color: ink color_hover: ink color_focus: ink color_empty: secondary color_empty_hover: secondary}}
                }
                View{width: Fill height: Fit flow: Right spacing: 6
                    Label{text: "日期" draw_text.color: ink draw_text.text_style.font_size: 13}
                    g_date_box := TextInput{width: Fill height: 27 empty_text: "如:10/3 周六"
                        draw_bg +: {color: #xf2f2f7 color_hover: #xf2f2f7 color_focus: #xf2f2f7 color_empty: #xf2f2f7 border_radius: 8.0}
                        draw_text +: {color: ink color_hover: ink color_focus: ink color_empty: secondary color_empty_hover: secondary}}
                    Label{text: "时间" draw_text.color: ink draw_text.text_style.font_size: 13}
                    g_time_box := TextInput{width: 64 height: 27 empty_text: "HH:MM"
                        draw_bg +: {color: #xf2f2f7 color_hover: #xf2f2f7 color_focus: #xf2f2f7 color_empty: #xf2f2f7 border_radius: 8.0}
                        draw_text +: {color: ink color_hover: ink color_focus: ink color_empty: secondary color_empty_hover: secondary}}
                    Label{text: "分钟" draw_text.color: ink draw_text.text_style.font_size: 13}
                    g_dur_box := TextInput{width: 52 height: 27 empty_text: "120"
                        draw_bg +: {color: #xf2f2f7 color_hover: #xf2f2f7 color_focus: #xf2f2f7 color_empty: #xf2f2f7 border_radius: 8.0}
                        draw_text +: {color: ink color_hover: ink color_focus: ink color_empty: secondary color_empty_hover: secondary}}
                }
                g_assess_btn := ButtonFlat{text: "评估风险" height: 28 padding: Inset{left: 12 right: 12} on_click: || g_reassess()
                    draw_bg +: {border_radius: 18.0 color: #x34c759 color_hover: #x30b350 color_down: #x28a24a border_size: 0.0}
                    draw_text +: {color: #xffffff color_hover: #ffffff color_down: #xffffff}}

            }
            g_nofc_lbl := Label{width: Fill height: Fit text: "" draw_text.color: secondary draw_text.text_style.font_size: 13}
        }
        g_s2 := View{visible: false width: Fill height: Fill flow: Down spacing: 4
            g_risk_card := View{width: Fill height: Fit flow: Down spacing: 4
                Label{text: "风险卡" draw_text.color: secondary draw_text.text_style.font_size: 11}
                g_risk_line := Label{width: Fill height: Fit text: "" draw_text.color: ink draw_text.text_style.font_size: 11}
                g_risk_src := Label{width: Fill height: Fit text: "" draw_text.color: secondary draw_text.text_style.font_size: 9}
            }
        }
        g_s3 := View{visible: false width: Fill height: Fill flow: Down spacing: 4
            View{width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5}
                g_confirm_btn := ButtonFlat{visible: false text: "确认执行" height: 30 padding: Inset{left: 14 right: 14} on_click: || g_confirm()
                    draw_bg +: {border_radius: 20.0 color: #x007aff color_hover: #x0a84ff color_down: #x0062cc border_size: 0.0}
                    draw_text +: {color: #xffffff color_hover: #xffffff color_down: #xffffff}}
                g_rules_btn := ButtonFlat{visible: false text: "改用规则" height: 30 padding: Inset{left: 14 right: 14} on_click: || agent_use_rules_now()
                    draw_bg +: {border_radius: 20.0 color: #xff9500 color_hover: #xe08600 color_down: #xc47600 border_size: 0.0}
                    draw_text +: {color: #xffffff color_hover: #xffffff color_down: #xffffff}}
            }
            g_opt_card := View{width: Fill height: Fit flow: Down spacing: 4
                g_opt_src := Label{text: "方案卡(来源:规则 · 单击选择)" draw_text.color: secondary draw_text.text_style.font_size: 11}
                g_opt_rows := View{width: Fill height: Fit flow: Down spacing: 2 on_render: || {
                    for i o in g_opts {
                        GestureView{width: Fill height: Fit flow: Down padding: 3 on_tap: |x, y| g_pick(i)
                            Label{width: Fill text: (if i == g_sel { "▶ " } else { "   " }) + o.id + " · " + o.label draw_text.color: ink draw_text.text_style.font_size: 12}
                            if i == g_sel {
                                Label{width: Fill text: o.why draw_text.color: secondary draw_text.text_style.font_size: 9}
                            }
                        }
                    }
                }}
            }
        }
        }
        g_s4 := View{visible: false width: Fill height: Fill flow: Down spacing: 4
            View{width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5}
                g_verify_btn := ButtonFlat{visible: false text: "核验" height: 30 padding: Inset{left: 14 right: 14} on_click: || g_verify()
                    draw_bg +: {border_radius: 20.0 color: #x34c759 color_hover: #x30b350 color_down: #x28a24a border_size: 0.0}
                    draw_text +: {color: #xffffff color_hover: #xffffff color_down: #xffffff}}
                g_verify_line := Label{width: Fill height: Fit text: "" draw_text.color: ink draw_text.text_style.font_size: 12}
            }
            g_execfail_lbl := Label{width: Fill height: Fit text: "" draw_text.color: #xff3b30 draw_text.text_style.font_size: 11}
            Label{text: "行程簿" draw_text.color: secondary draw_text.text_style.font_size: 11}
            g_plan_rows := View{width: Fill height: Fit flow: Down spacing: 4 on_render: || {
                if g_undo_plan != nil {
                    GestureView{width: Fill height: Fit padding: 8 on_tap: |x, y| undo_del()
                        Label{width: Fill text: "↩ 撤销删除:" + g_undo_plan.place + " " + short_date(g_undo_plan.date) + " " + g_undo_plan.start draw_text.color: #xff9500 draw_text.text_style.font_size: 14}
                    }
                }
                if g_plans.len() == 0 && g_undo_plan == nil { Label{text: "还没有已确认的计划" draw_text.color: secondary draw_text.text_style.font_size: 12} }
                for i p in g_plans {
                    GestureView{width: Fill height: Fit padding: 5 on_tap: |x, y| plan_row_tap(i)
                        View{width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5}
                            Label{width: Fill text: p.place + " · " + short_date(p.date) + " " + p.start + (if p.indoor {" · 室内"} else {""}) + checklist_str(p) draw_text.color: ink draw_text.text_style.font_size: 14}
                            Label{text: "删除" draw_text.color: #xff3b30 draw_text.text_style.font_size: 12}
                        }
                    }
                }
            }}
        }
    }
}
